{
  "version": 2,
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/memories/:userId/:memoryId?",
      "destination": "/api/chat.js?action=memories&userId=:userId&memoryId=:memoryId"
    },
    {
      "source": "/api/tasks",
      "destination": "/api/tasks.js"
    },
    {
      "source": "/api/google/auth",
      "destination": "/api/google.js?action=auth"
    },
    {
      "source": "/api/google/callback",
      "destination": "/api/google.js?action=callback"
    },
    {
      "source": "/api/gmail/send",
      "destination": "/api/google.js?action=gmail_send"
    },
    {
      "source": "/api/calendar/create",
      "destination": "/api/google.js?action=calendar_create"
    },
    {
      "source": "/api/drive/list",
      "destination": "/api/google.js?action=drive_list"
    },
    {
      "source": "/api/telegram/connect",
      "destination": "/api/telegram.js"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/google.js?action=gmail_send"
    },
    {
      "source": "/api/video/prepare",
      "destination": "/api/video_prepare.js"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/site_host.js?slug=:slug"
    },
    {
      "source": "/p/:slug/:path*",
      "destination": "/api/site_host.js?slug=:slug&path=:path"
    },
    {
      "source": "/sites/:slug",
      "destination": "/api/site_host.js?slug=:slug"
    },
    {
      "source": "/sites/:slug/:path*",
      "destination": "/api/site_host.js?slug=:slug&path=:path"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11"
  }
}
